{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "colors": { "blocked": "#f97316", "working": "#3b82f6", "done": "#22c55e", "idle": "#22c55e" },
  "theme": {
    "light": "paper",
    "dark": "graphite"
  },
  "ui_font": "Geist",
  "font_size": 13,
  "terminal_padding": [
    12,
    10
  ],
  "gap": 0,
  "resizable": true,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "agent-columns-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agent-columns-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "agent-columns-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "gap": 0,
      "resizable": false,
      "children": [
        {
          "id": "cols-header",
          "type": "block",
          "size": {
            "px": 48
          },
          "window_drag": true,
          "content": {
            "mod": "agent-columns",
            "props": {
              "role": "header"
            }
          }
        },
        {
          "id": "cols-cards",
          "type": "block",
          "size": {
            "px": 355
          },
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "agent-columns"
          }
        },
        {
          "id": "workspace",
          "type": "column",
          "padding": [
            14,
            24
          ],
          "gap": 0,
          "resizable": false,
          "children": [
            {
              "id": "workspace-title",
              "type": "block",
              "size": {
                "px": 34
              },
              "background": "surface",
              "radius": 7,
              "content": {
                "mod": "agent-columns",
                "props": {
                  "role": "terminals"
                }
              }
            },
            {
              "id": "live-terminals",
              "type": "block",
              "background": "surface",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 12,
                  "radius": 7,
                  "background": "surface",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "agent-columns",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "height": 28,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/agent-columns.svg"
}